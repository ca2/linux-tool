#!/usr/bin/env bash

bin=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 1

option=${1:-}
case $option in
    --tailscale-hostname-to-cloudflare-subdomain)
        shift
        exec "$bin/_tailscale_hostname_to_cloudflare_subdomain" "$@"
        ;;
    --shell|--create-shortcut-executables|--initialize-project-root|--initialize-project-root-instance)
        shift
        checkout=
        case $# in
            0)
                # Walk up through nested submodules to the project checkout.
                if ! checkout=$(git rev-parse --show-toplevel 2>/dev/null); then
                    printf '%s\n' 'Run from a project checkout or supply --root CHECKOUT.' >&2
                    exit 1
                fi
                while parent=$(git -C "$checkout" rev-parse --show-superproject-working-tree 2>/dev/null) &&
                      [[ -n $parent ]]; do
                    checkout=$parent
                done
                ;;
            1) checkout=$1 ;;
            2) [[ $1 == --root ]] && checkout=$2 ;;
        esac
        if [[ -z ${checkout:-} || $checkout == --* ]]; then
            printf 'Usage: application_build_helper %s [CHECKOUT | --root CHECKOUT]\n' "$option" >&2
            exit 2
        fi
        checkout=$(cd -- "$checkout" && pwd -P) || exit 1
        project_tool="$checkout/operating_system/operating_system-linux/tool"
        if [[ $(git -C "$checkout" rev-parse --show-toplevel 2>/dev/null) != "$checkout" ||
              ! -x "$project_tool/bin/application_build_helper" || ! -f "$project_tool/shell" ]]; then
            printf 'Expected a Git checkout with the Linux tools initialized: %s\n' "$checkout" >&2
            exit 1
        fi
        ;;
    *)
        architecture=$(uname -m) || exit 1
        exec "$bin/$architecture/application_build_helper" "$@"
        ;;
esac

if [[ $option == --initialize-project-root ]]; then
    template="$bin/../project_root/shell"
    mkdir -p -- "$checkout/tool" || exit 1
    if [[ ! -x "$checkout/tool/shell" ]] || ! cmp -s -- "$template" "$checkout/tool/shell"; then
        install -m 755 -- "$template" "$checkout/tool/shell" || exit 1
    fi
    for rule in /shell.desktop /_project_root_instance/; do
        if ! grep -Fxq -- "$rule" "$checkout/.gitignore" 2>/dev/null; then
            printf '\n%s\n' "$rule" >> "$checkout/.gitignore" || exit 1
        fi
    done
    exit 0
fi

if [[ ! -x "$checkout/tool/shell" ]]; then
    printf 'Missing executable %s. Run initialize_project_root first.\n' "$checkout/tool/shell" >&2
    exit 1
fi

if [[ $option == --shell ]]; then
    exec "$bin/launch_terminal" "$checkout"
fi

if [[ $option == --initialize-project-root-instance ]]; then
    state="$checkout/_project_root_instance"
    if [[ -L $state ]]; then
        printf 'Instance state directory must be inside the checkout: %s\n' "$state" >&2
        exit 1
    fi
    architecture=$(uname -m) || exit 1
    if ! . "$bin/defer_ssh_agent"; then
        printf '%s\n' 'Could not initialize the fallback SSH agent.' >&2
    fi
    "$bin/$architecture/application_build_helper" "$option" --root "$checkout" || exit $?
    # Bundled helpers from older revisions may still generate the old path.
    legacy_environment="$checkout/_root_project_instance/_environment"
    if [[ -r "$legacy_environment" && ! -r "$state/_environment" ]]; then
        mkdir -p -- "$state" || exit 1
        mv -n -- "$legacy_environment" "$state/_environment" || exit 1
    fi
    if [[ ! -r "$state/_environment" ]]; then
        printf 'Missing generated shell environment: %s/_environment\n' "$state" >&2
        exit 1
    fi
fi

# Exec resolves the workspace helper relative to the desktop entry working directory.
desktop_path=${checkout//\\/\\\\}
desktop_path=${desktop_path//$'\t'/\\t}
desktop_path=${desktop_path//$'\r'/\\r}
desktop_path=${desktop_path//$'\n'/\\n}
shortcut="$checkout/shell.desktop"
temporary=$(mktemp -- "$checkout/.shell.desktop.XXXXXXXX") || exit 1
trap 'rm -f -- "$temporary" "${marker_temporary:-}"' EXIT
cat > "$temporary" <<DESKTOP || exit 1
[Desktop Entry]
Type=Application
Name=Workspace Shell
Icon=utilities-terminal
Exec=/usr/bin/env ./operating_system/operating_system-linux/tool/bin/application_build_helper --shell
Path=$desktop_path
Terminal=false
DESKTOP
chmod u+x -- "$temporary" || exit 1
mv -fT -- "$temporary" "$shortcut" || exit 1
if [[ $option == --initialize-project-root-instance ]]; then
    mkdir -p -- "$state" || exit 1
    marker_temporary=$(mktemp -- "$state/.initialized-root.XXXXXXXX") || exit 1
    printf '1:%s\n' "$checkout" > "$marker_temporary" || exit 1
    mv -fT -- "$marker_temporary" "$state/initialized-root.txt" || exit 1
fi
printf '%s\n' "$shortcut"
