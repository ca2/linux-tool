#!/usr/bin/env bash
set -euo pipefail

install_root=${HOME:?}/.local/share/ca2/git-credential-manager
github_url=https://github.com
helper_key=credential.https://github.com.helper

if [[ -L "$install_root" ]]; then
    printf 'Refusing to remove a symlinked installation directory: %s\n' "$install_root" >&2
    exit 1
fi

installations=()
for directory in "$install_root"/*; do
    if [[ ${directory##*/} =~ ^[0-9]+\.[0-9]+\.[0-9]+-(x64|arm64)$ &&
          -d "$directory" && ! -L "$directory" &&
          -x "$directory/git-credential-manager" && ! -L "$directory/git-credential-manager" ]]; then
        installations+=("$directory")
    fi
done
if (( ${#installations[@]} == 0 )); then
    printf '%s\n' 'No Git Credential Manager installation from initialize_project_root_instance was found.'
    exit 0
fi

store=${GCM_CREDENTIAL_STORE:-}
if [[ -z "$store" ]]; then
    store=$(git config --global --get-urlmatch credential.credentialStore "$github_url") || {
        status=$?
        (( status == 1 )) || exit "$status"
    }
fi
if [[ -n "$store" && "$store" != none ]]; then
    manager=${installations[0]}/git-credential-manager
    # GCM sends its console output to stderr to keep stdout free for Git's
    # credential protocol.
    accounts=$(GCM_CREDENTIAL_STORE="$store" "$manager" github list --url "$github_url" 2>&1) || {
        printf '%s\n' "$accounts" >&2
        printf 'Could not list GitHub accounts in the %s store. The installation is still available.\n' "$store" >&2
        exit 1
    }
    while IFS= read -r account; do
        [[ "$account" =~ ^[[:alnum:]][[:alnum:]_-]*$ ]] || continue
        GCM_CREDENTIAL_STORE="$store" "$manager" github logout --url "$github_url" -- "$account"
    done <<< "$accounts"
fi

for directory in "${installations[@]}"; do
    # Match the exact shell-quoted helper value registered by setup.
    manager="$directory/git-credential-manager"
    quoted=${manager//\'/\'\\\'\'}
    git config --global --fixed-value --unset-all "$helper_key" "!'$quoted'" || {
        status=$?
        (( status == 5 )) || exit "$status"
    }
    rm -r -- "$directory"
done
printf '%s\n' 'Removed the setup-installed Git Credential Manager and cleared the GitHub logins in its configured store.'
