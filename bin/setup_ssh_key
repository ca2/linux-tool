#!/usr/bin/env bash
set -eu

if (( $# > 1 )) || [[ ${1-} == -* ]]; then
  printf 'Usage: %s [user@host]\n' "${0##*/}" >&2
  exit 2
fi

umask 077
key="$HOME/.ssh/id_ed25519"
mkdir -p -- "$HOME/.ssh"
chmod 700 -- "$HOME/.ssh"

if [[ ! -e "$key" && ! -L "$key" ]]; then
  ssh-keygen -t ed25519 -f "$key"
fi

if [[ ! -s "$key" ]]; then
  printf 'No usable private key at %s\n' "$key" >&2
  exit 1
fi

if [[ ! -e "$key.pub" && ! -L "$key.pub" ]]; then
  public_key=$(ssh-keygen -y -f "$key")
  (set -o noclobber; printf '%s\n' "$public_key" > "$key.pub")
fi

if (( $# == 1 )); then
  exec ssh-copy-id -i "$key.pub" "$1"
fi

printf 'Public key ready at %s\n' "$key.pub"
